<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The game's Mono runtime lacks the netstandard facade. Use net48 for the
         mod, while retaining netstandard2.0 for the standalone test project. -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>RareParts</RootNamespace>
    <LangVersion>14</LangVersion>
    <Configurations>Debug;Release;Release-Deploy</Configurations>
    <Optimize Condition="'$(Configuration)' == 'Release-Deploy'">true</Optimize>
  </PropertyGroup>
</Project>
